FROM php:8.4-fpm-trixie

ENV ACCEPT_EULA=Y \
    PATH="${PATH}:/opt/mssql-tools18/bin"

# Dependencias base y repositorio Microsoft
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ca-certificates \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/13/prod trixie main" \
    > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
        msodbcsql18 \
        mssql-tools18 \
    && apt-get purge -y --auto-remove gnupg \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions installer
COPY --from=ghcr.io/mlocati/php-extension-installer:2.11.12 /usr/bin/install-php-extensions /usr/bin/install-php-extensions

# Composer se conserva para administrar dependencias bajo demanda.
COPY --from=composer:2.10.2 /usr/bin/composer /usr/local/bin/composer

# Extensiones PHP (TCPDF + SQL Server)
RUN chmod +x /usr/bin/install-php-extensions \
    && install-php-extensions \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        fileinfo \
        opcache \
        pcntl \
        pdo_sqlsrv \
        sqlsrv \
        zip \
        redis

WORKDIR /var/www
