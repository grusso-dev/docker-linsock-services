# Ejemplos para copiar a .env y ADAPTAR antes de desplegar.
# No guardar contraseñas reales en Git. .env ya estuvo versionado: rotar sus claves.

# Imagen de ejemplo; en producción sustituir la etiqueta mutable por un digest
# validado: mcr.microsoft.com/mssql/server@sha256:<digest-real>.
SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Standard requiere licencia válida; elegir la edición que corresponda.
MSSQL_PID=Standard

# EJEMPLO INSEGURO: reemplazar por una contraseña nueva, larga y privada.
SA_PASSWORD=CAMBIAR_ESTA_CLAVE_LARGA_2026!

# Base existente a respaldar. Solo letras, números, _ y -; se respalda una base.
SQL_DB=MiBaseDeDatos
# Si se usa otro usuario, debe poder respaldar y usar la contraseña indicada arriba.
SQL_USER=sa

# IP DE DOCUMENTACIÓN: cambiar por una IP real asignada al host (no la del cliente).
# Restringir TCP 1433 con firewall/VPN; el bind no filtra IP de origen.
SQL_BIND_IP=192.0.2.10

# Ejemplo para ESTE host: directorio ya creado, fuera de sql_data.
# Si mueves el proyecto, actualiza esta ruta absoluta y revisa permisos.
SQL_BACKUP_PATH=/home/grusso/customers/linsock/docker-linsock-services/dkr-sql/data/sqlserver/backups

# Días de conservación local tras un backup verificado; copiar backups fuera del host.
BACKUP_RETENTION_DAYS=7
